<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Brother DCP-T420W Driver</title>
    <organization>com.hwisu</organization>
    <domains enable_localSystem="true" enable_anywhere="false" enable_currentUserHome="false"/>
    <options customize="never" require-scripts="true" hostArchitectures="arm64,x86_64"/>
    <allowed-os-versions>
        <os-version min="11.0"/>
    </allowed-os-versions>

    <welcome    file="welcome.html"    mime-type="text/html"/>
    <license    file="license.txt"     mime-type="text/plain"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>

    <choices-outline>
        <line choice="default">
            <line choice="com.hwisu.dcp-t420w"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.hwisu.dcp-t420w" visible="false">
        <pkg-ref id="com.hwisu.dcp-t420w"/>
    </choice>
    <pkg-ref id="com.hwisu.dcp-t420w" version="VERSION" onConclusion="none">component.pkg</pkg-ref>
</installer-gui-script>
